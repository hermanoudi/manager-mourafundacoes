DATABASE_URL=postgresql+psycopg://moura:moura@localhost:5440/moura
JWT_SECRET=troque-por-openssl-rand-hex-32
COOKIE_SECURE=false
ENVIRONMENT=dev

# Leitura das fotos de anotações por IA (gemini | fake). Sem chave: foto salva, linhas digitadas.
NOTES_EXTRACTOR=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Menor que os 30 s do rewrite do Next (/api/* → API), senão o cliente perde o photo_id.
EXTRACTION_TIMEOUT_S=20

# Fotos: local (dev) ou s3 (obrigatório com ENVIRONMENT=prod; Railway Bucket ou Cloudflare R2)
STORAGE_BACKEND=local
STORAGE_LOCAL_DIR=var/uploads
MAX_UPLOAD_MB=8
# S3_ENDPOINT_URL=https://<conta>.r2.cloudflarestorage.com
# S3_BUCKET=moura-fotos
# S3_REGION=auto
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
